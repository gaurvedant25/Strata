# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> Data API). Both are safe to ship in the bundle:
# every row is guarded by row-level security, so the key alone reads nothing.
#
# Leave these unset and the app runs exactly as it did before accounts existed:
# local IndexedDB only, no sign-in screen, no network.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
