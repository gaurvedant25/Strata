# Copy to `android/keystore.properties` and fill in. That file is gitignored:
# it holds the passwords to the key that identifies this app to Play, and
# anyone with both it and the keystore can publish as you.
#
# Use FORWARD slashes even on Windows. This is a Java properties file, where a
# backslash starts an escape sequence, so C:\Users\... silently becomes garbage.
#
# The keystore itself is generated once and kept somewhere safe outside the
# repository:
#
#   keytool -genkeypair -v -keystore strata-upload.jks \
#           -alias upload -keyalg RSA -keysize 2048 -validity 10000

storeFile=C:/Users/you/.androidbuild/strata-upload.jks
storePassword=
keyAlias=upload
keyPassword=
