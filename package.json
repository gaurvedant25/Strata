{
  "name": "gym",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/icons.mjs",
    "check:cloud": "node scripts/check-cloud.mjs",
    "check:streaks": "node scripts/check-streaks.cjs",
    "check:shares": "node scripts/check-workout-share.cjs",
    "check:rankings": "node scripts/check-rankings.cjs",
    "check:similar": "node scripts/check-similar.cjs",
    "check:art": "node scripts/check-art.cjs",
    "check:trend": "node scripts/check-trend.cjs",
    "check:entitlement": "node scripts/check-entitlement.cjs",
    "apk": "node scripts/build-android.mjs",
    "aab": "node scripts/build-android.mjs --release",
    "deploy": "npm run build && npx vercel link --yes --project gym-log --cwd dist && npx vercel deploy --prod --yes --cwd dist"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.115.0",
    "cordova-plugin-purchase": "^13.18.0",
    "idb": "^8.0.3",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
